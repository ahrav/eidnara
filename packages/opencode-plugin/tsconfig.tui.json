{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "emitDeclarationOnly": false,
        "jsx": "preserve",
        "jsxImportSource": "@opentui/solid",
        "lib": [
            "ES2022",
            "DOM"
        ]
    },
    "include": [
        "src/tui/**/*.tsx",
        "src/tui/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/tui-compiled"
    ]
}
