  "operation": {
    "typed_request": "serde_json::from_slice::<TransformRequest>(&body); the decoded request is dropped outside the timed interval (Criterion iter_with_large_drop)",
    "typed_request_plus_projection": "serde_json::from_slice::<TransformRequest>(&body) then wire::project_messages(&request.messages); request and projection both stay live to the end of the interval and are dropped outside it",
    "excluded": "transport, probing, admission (decode_metered), store work, response encoding",
    "warmup": "Criterion default 3 s per cell",
    "measurement": "Criterion default 5 s per cell, 100 samples, automatic sampling: linear for both typed_request cells and the 40-message projection cell; flat (12 iterations per sample) for the 200-message projection cell",
    "order_within_process": "typed_request/40, plus_projection/40, typed_request/200, plus_projection/200 (Criterion registration order)",
    "estimators": "Criterion's console `time:` line is the slope estimator under linear sampling and the mean under flat sampling (the flat cell's estimates.json has slope null); estimates.json also holds mean, median, MAD, and std_dev. The predeclared rule uses the mean; slopes are retained for cross-checking where present."
  },
  "replication": {
    "processes": 5,
    "assignment": "before leg only; each run is a fresh process of the same binary",
    "after_leg": "to be collected by the U1 ticket with the same harness patch applied to its final tree, alternating before/after process order AB,BA,AB,BA,AB across five pairs"
  },
  "predeclared_rule": {
    "noise_floor": "per cell, the relative spread of the five before-leg process means (max-min over median), recorded below",
    "proceed": "for every one of the four cells, in at least four of five process pairs the after-leg mean is below the before-leg mean by more than twice that cell's before-leg noise floor, and the median per-pair after/before mean ratio is below 1.0 minus twice the noise floor",
    "within_noise": "any cell whose median per-pair ratio falls inside 1.0 plus or minus twice its noise floor: stop for the whole plan per P:L18",
    "regression": "any cell whose median per-pair ratio exceeds 1.0 plus twice its noise floor: not a faster claim; report",
    "uncertainty": "Criterion bootstrap 95% confidence interval of the mean per process, plus the process-level spread; iterations are never pooled across processes"
  },
