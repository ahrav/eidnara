{
    "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "assist": {
        "enabled": true
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "noForEach": "off"
            },
            "correctness": {
                "noUnusedImports": "error",
                "noUnusedVariables": "error"
            },
            "style": {
                "noNonNullAssertion": "warn",
                "useConst": "error",
                "noRestrictedImports": {
                    "level": "error",
                    "options": {
                        "paths": {
                            "@eidnara/opencode": "The bare specifier resolves to an installed dist. Use a relative import inside this package; other packages use the `@eidnara/opencode/*` path alias.",
                            "@eidnara/pi": "The bare specifier resolves to an installed dist. Use the `@eidnara/pi/*` path alias."
                        }
                    }
                }
            },
            "suspicious": {
                "noExplicitAny": "warn",
                "noAssignInExpressions": "off",
                "noTemplateCurlyInString": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "trailingCommas": "all",
            "semicolons": "always"
        }
    },
    "files": {
        "includes": [
            "src/**/*.ts",
            "src/**/*.tsx",
            "!src/tui-compiled",
            "scripts/**/*.ts",
            "scripts/**/*.mjs",
            "test-preload.ts"
        ]
    },
    "overrides": [
        {
            "includes": ["**/__tests__/**", "**/*.test.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    },
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        },
        {
            "includes": ["src/hooks/context/image-token-estimate.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        }
    ]
}
