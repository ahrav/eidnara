{
  "selector": [
    {
      "name": "absent profile is environment mode",
      "env": {
        "HOME": "/home/u",
        "AWS_ACCESS_KEY_ID": "AKIA",
        "AWS_SECRET_ACCESS_KEY": "s"
      },
      "expect": {
        "mode": "environment"
      }
    },
    {
      "name": "absent profile ignores a relative HOME",
      "env": {
        "HOME": "rel"
      },
      "expect": {
        "mode": "environment"
      }
    },
    {
      "name": "defaults derive from HOME",
      "env": {
        "HOME": "/home/u",
        "AWS_PROFILE": "corp",
        "AWS_REGION": "us-east-1"
      },
      "expect": {
        "mode": "profile",
        "source": {
          "kind": "profile",
          "profile": "corp",
          "region": "us-east-1",
          "config_file": "/home/u/.aws/config",
          "credentials_file": "/home/u/.aws/credentials",
          "sso_cache_root": "/home/u/.aws/sso/cache"
        }
      }
    },
    {
      "name": "HOME is normalized lexically",
      "env": {
        "HOME": "/home//u/./x/../",
        "AWS_PROFILE": "corp",
        "AWS_REGION": "us-east-1"
      },
      "expect": {
        "mode": "profile",
        "source": {
          "kind": "profile",
          "profile": "corp",
          "region": "us-east-1",
          "config_file": "/home/u/.aws/config",
          "credentials_file": "/home/u/.aws/credentials",
          "sso_cache_root": "/home/u/.aws/sso/cache"
        }
      }
    },
    {
      "name": "root HOME",
      "env": {
        "HOME": "/",
        "AWS_PROFILE": "corp",
        "AWS_REGION": "us-east-1"
      },
      "expect": {
        "mode": "profile",
        "source": {
          "kind": "profile",
          "profile": "corp",
          "region": "us-east-1",
          "config_file": "/.aws/config",
          "credentials_file": "/.aws/credentials",
          "sso_cache_root": "/.aws/sso/cache"
        }
      }
    },
    {
      "name": "overrides are normalized lexically",
      "env": {
        "HOME": "/home/u",
        "AWS_PROFILE": "corp",
        "AWS_REGION": "us-east-1",
        "AWS_CONFIG_FILE": "/etc//aws/./cfg/../config",
        "AWS_SHARED_CREDENTIALS_FILE": "/srv/creds/"
      },
      "expect": {
        "mode": "profile",
        "source": {
          "kind": "profile",
          "profile": "corp",
          "region": "us-east-1",
          "config_file": "/etc/aws/config",
          "credentials_file": "/srv/creds",
          "sso_cache_root": "/home/u/.aws/sso/cache"
        }
      }
    },
    {
      "name": "a different spelling of one target is a different selector",
      "env": {
        "HOME": "/home/u",
        "AWS_PROFILE": "corp",
        "AWS_REGION": "us-east-1",
        "AWS_CONFIG_FILE": "/home/u/.aws/../.aws/cfg"
      },
      "expect": {
        "mode": "profile",
        "source": {
          "kind": "profile",
          "profile": "corp",
          "region": "us-east-1",
          "config_file": "/home/u/.aws/cfg",
          "credentials_file": "/home/u/.aws/credentials",
          "sso_cache_root": "/home/u/.aws/sso/cache"
