{
    "name": "@eidnara/e2e-tests",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "test": "bun run ensure:plugin-dist && bun test scripts src",
        "test:rust": "bun run --cwd ../opencode-plugin build && bun run ensure:pi-dist && bun scripts/run-test-selection.ts --mode rust --timeout 600000 --max-concurrency 1",
        "test:fixture-contract": "bun test src/rust-runner/hermetic-host.test.ts",
        "test:incidents:rust": "bun run ensure:plugin-dist && bun scripts/run-incident-pool.ts --mode rust",
        "validate-mode-manifest": "bun scripts/validate-mode-manifest.ts --mode rust",
        "validate:incident-history": "bun scripts/validate-incident-history.ts",
        "validate:incident-history:ci": "bun scripts/validate-incident-history.ts --ci",
        "validate:incident-verifiers": "bun scripts/validate-incident-verifiers.ts --base origin/main",
        "validate:incident-verifiers:ci": "bun scripts/validate-incident-verifiers.ts --ci",
        "validate:shm-hardening-matrix": "bun scripts/validate-shm-hardening-matrix.ts",
        "soak:shm": "bun scripts/run-shm-soak.ts",
        "mutation:rust-historian": "bun run ensure:plugin-dist && bun scripts/run-rust-historian-producer-mutation.ts",
        "mutation:rust-ctx-reduce": "bun run ensure:plugin-dist && bun scripts/run-rust-ctx-reduce-mutation.ts",
        "mutation:rust-fm": "bun scripts/run-rust-fm-mutation.ts",
        "mutation:goldens": "bun scripts/run-goldens-mutation.ts",
        "ensure:plugin-dist": "test -f ../opencode-plugin/dist/index.js || bun run --cwd ../opencode-plugin build",
        "ensure:pi-dist": "(test -f ../shm-native/index.js || bun run --cwd ../shm-native build:js) && (test -f ../pi-plugin/dist/index.js || bun run --cwd ../pi-plugin build)"
    },
    "dependencies": {
        "@eidnara/shm-native": "0.1.0",
        "@opencode-ai/sdk": "^1.17.11"
    },
    "devDependencies": {
        "@types/bun": "1.3.14",
        "@types/node": "^22.20.0",
        "typescript": "5.9.3"
    }
}
