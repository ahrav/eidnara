{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "lib": [
            "ES2022"
        ],
        "outDir": "dist",
        "rootDir": "src",
        "types": [
            "bun",
            "node"
        ],
        "baseUrl": ".",
        "paths": {
            "@eidnara/fs-observer/*": [
                "../fs-observer/dist/types/*",
                "../fs-observer/src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "scripts",
        "src/**/*.test.ts",
        "src/**/__tests__/**"
    ],
    "references": [
        {
            "path": "../fs-observer/tsconfig.build.json"
        }
    ]
}
